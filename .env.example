# Live Clipper needs no environment variables. Everything below is optional and holds placeholders only.
# Copy to .env if you like; never commit a real .env.

# Use a different data folder (database, logs, secrets, default media folder).
# LIVE_CLIPPER_HOME=/path/to/live-clipper-data

# Let the server listen on a non-loopback address. Leave unset unless you know why you need it.
# LIVE_CLIPPER_ALLOW_REMOTE=1
